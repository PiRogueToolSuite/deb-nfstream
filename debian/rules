#!/usr/bin/make -f

export PYBUILD_NAME := nfstream
export TOPLEVEL_DIR := $(CURDIR)

%:
	dh $@ --with quilt,python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	find debian/python3-nfstream/ -name visopts.py -print -delete

# We need at least one patch applied to ensure clean doesn't build everything:
override_dh_auto_clean:
	dh_quilt_patch
	dh_auto_clean
	dh_quilt_unpatch
	# Temporary install steps happen with $(TOPLEVEL_DIR)/tmp/nfstream_build:
	rm -rf tmp
	# Leftovers:
	rm -f nfstream/engine/dependencies/nDPI/tests/do-dga.sh
	rm -f nfstream/engine/dependencies/nDPI/tests/do-unit.sh
